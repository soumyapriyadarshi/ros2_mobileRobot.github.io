    <model name="start_marker_red">
      <static>true</static>
      <pose>-8.0 -8.0 0.0245 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material>
