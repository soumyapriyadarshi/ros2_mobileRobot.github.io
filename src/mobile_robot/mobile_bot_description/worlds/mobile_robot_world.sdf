<?xml version="1.0"?>
<sdf version="1.9">
  <world name="mobile_robot_house_world">

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Needed for the gpu_lidar. Remove the Sensors plugin from mobile_robot.gazebo.xacro to avoid loading it twice. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.55 0.55 0.58 1</ambient>
      <background>0.78 0.87 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.88 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- FLOOR -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.90 0.89 0.85 1</ambient><diffuse>0.90 0.89 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- OUTER WALLS (navy) -->
    <model name="north_boundary">
      <static>true</static>
      <pose>0.000 9.900 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.000 0.200 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.000 0.200 2.5</size></box></geometry>
          <material><ambient>0.13 0.17 0.27 1</ambient><diffuse>0.13 0.17 0.27 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="south_boundary">
      <static>true</static>
      <pose>0.000 -9.900 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.000 0.200 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.000 0.200 2.5</size></box></geometry>
          <material><ambient>0.13 0.17 0.27 1</ambient><diffuse>0.13 0.17 0.27 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="west_boundary">
      <static>true</static>
      <pose>-9.900 0.000 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.200 20.000 2.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.200 20.000 2.5</size></box></geometry>
          <material><ambient>0.13 0.17 0.27 1</ambient><diffuse>0.13 0.17 0.27 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>
    <model name="east_boundary">
      <static>true</static>
      <pose>9.900 0.000 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.200 20.000 2.5</size></box></geometry></collision>
