    <!-- START (orange) -->
    <model name="start_marker">
      <static>true</static>
      <pose>-8 -8 0.0125 0 0 0</pose>
      <link name="link"><visual name="visual">
        <geometry><cylinder><radius>0.5</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.98 0.45 0.10 1</ambient><diffuse>0.98 0.45 0.10 1</diffuse></material>
      </visual></link>
    </model>

    <!-- GOAL (green, slightly glowing) -->
    <model name="goal_marker_green">
      <static>true</static>
